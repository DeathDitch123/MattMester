# SMTP beallitasok valodi email kuldeshez
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-user@example.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_FROM="MattMester <no-reply@example.com>"

# Opcionlis publikus URL a verifikacios linkhez
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Opcionlis session secret
SESSION_SECRET=replace-with-a-strong-random-secret

# Opcionlis CORS lista (vesszovel elvalasztva)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000