# MattMester — example environment file
# Másold át .env néven (a repo gyökerébe vagy backend/ alá) és töltsd ki a saját értékeiddel.
# A backend mindkét helyet betölti (backend/.env > repo-gyökér .env), és a már beállított érték nem íródik felül.

# === Kötelező / biztonsági ===

# Futási környezet. Production-ben SESSION_SECRET hiánya azonnali kilépést okoz, és cookie.secure=true + sameSite=strict.
NODE_ENV=development

# Express-session aláíró kulcs. Production-ben kötelező, dev-ben hiánya warning + random fallback.
# Generálj erős random értéket, pl.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# CORS — vesszővel elválasztott origin-lista. Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Adatbázis ===
# Default: 127.0.0.1:3306, root / üres jelszó, "mattmester" DB (XAMPP-kompatibilis).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mattmester

# === Egyéb ===

# Debug log-szint kapcsoló (lásd issues.md #55). Üres / 0 / false → kikapcsolva.
DEBUG=

# Chat moderáció: 'soft_warn' | 'hard_block'
CHAT_BLACKLIST_POLICY=hard_block

# === SMTP (opcionális — email verifikációhoz, jelszó-visszaállításhoz) ===
# Hiányában a backend "json-dev" fallback módba vált, és a leveleket logba írja.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
PUBLIC_BASE_URL=http://127.0.0.1:3000
